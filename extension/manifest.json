{
  "manifest_version": 3,
  "name": "VoiceForm — Hands-free Form Filling",
  "version": "1.0.0",
  "description": "Fill any web form using voice commands, with spoken confirmation powered by Rime TTS.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoiceForm"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["voiceform-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
