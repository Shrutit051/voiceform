# Copy this file to .env and fill in your own key. Never commit .env.
RIME_API_KEY=your_rime_api_key_here

PORT=3000

# Optional overrides — defaults shown. See README for how to verify these
# against Rime's live model/voice/language catalog before your demo.
RIME_MODEL_ID=mistv3
RIME_SPEAKER=cove
RIME_LANG=en
