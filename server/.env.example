# Copy this file to .env and fill in your keys. Never commit .env.
RIME_API_KEY=your_rime_api_key_here

# Optional LLM Form Agent Brain (supports Gemini 2.0 Flash, Groq, or OpenAI)
# If left empty, VoiceForm will use its built-in local heuristic engine.
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

PORT=3000

# Optional Rime overrides — defaults shown:
# RIME_MODEL_ID=mistv3
# RIME_SPEAKER=cove
# RIME_LANG=en
